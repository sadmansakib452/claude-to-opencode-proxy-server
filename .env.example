# OpenCode API Key (Required)
OPENCODE_API_KEY=your_opencode_api_key_here

# Default Model
# Options: muse-spark-1.2-contributor-free, deepseek-ai/deepseek-v3, glm-4-plus, etc.
MODEL=muse-spark-1.2-contributor-free

# Upstream Endpoint (Optional if using default auto-routing)
ENDPOINT=https://opencode.ai/zen/v1/responses

# Optional Proxy Port (Default: 8787)
# CLAUDE_OPENCODE_PROXY_PORT=8787
