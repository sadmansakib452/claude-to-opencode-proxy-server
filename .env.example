# OpenCode API Key (Required)
# Multi-Key Pool: Comma-separated keys will automatically rotate on 429 rate limit
# Example: OPENCODE_API_KEY=sk-key1,sk-key2,sk-key3
OPENCODE_API_KEY=your_opencode_api_key_here

# Primary Model (Optionally bind to custom endpoint with model|endpoint)
# Options: muse-spark-1.2-contributor-free, deepseek-ai/deepseek-v3, glm-4-plus, etc.
# Example: MODEL=muse-spark-1.2-contributor-free|https://opencode.ai/zen/v1/responses
MODEL=muse-spark-1.2-contributor-free

# Fallback Models Chain (Optional)
# If primary model exhausts retries/rate-limits, automatically fail over in order.
# You can bind each model to its own specific endpoint with model|endpoint!
# Example: FALLBACK_MODELS=deepseek-ai/deepseek-v3|https://opencode.ai/zen/go/v1/chat/completions,deepseek-chat|https://api.deepseek.com/v1/chat/completions
# FALLBACK_MODELS=deepseek-ai/deepseek-v3,glm-4-plus

# Upstream Endpoint (Optional if using default auto-routing)
ENDPOINT=https://opencode.ai/zen/v1/responses

# Optional Proxy Port (Default: 8787)
# CLAUDE_OPENCODE_PROXY_PORT=8787

# Reliability & Auto-Retry Settings (on 429, 502, 503)
# CLAUDE_OPENCODE_RETRY_MAX=3
# CLAUDE_OPENCODE_RETRY_BASE_MS=1500
# CLAUDE_OPENCODE_RETRY_MAX_MS=15000

# High Context Warning Threshold (number of messages in history)
# CLAUDE_OPENCODE_CONTEXT_WARN_THRESHOLD=200

# Verbose Upstream Debug Logs
# CLAUDE_OPENCODE_DEBUG=1
